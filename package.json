{
  "name": "browser-mcp",
  "version": "1.0.1",
  "description": "Pagewright: let AI agents see and control your real Chrome/Brave/Edge through MCP. Page snapshots, screenshots, real clicks, layout audits, CSS debugging and web scraping.",
  "type": "module",
  "bin": {
    "browser-mcp": "server/index.js"
  },
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "test": "node test/smoke.mjs && node scripts/gen-docs.mjs --check",
    "test:e2e": "node test/e2e.mjs",
    "docs": "node scripts/gen-docs.mjs",
    "check-syntax": "node scripts/check-syntax.mjs",
    "build:store": "node scripts/build-store.mjs",
    "store:assets": "node scripts/store-assets.mjs",
    "demo:gif": "node scripts/demo-gif.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ws": "^8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zamansheikh/browser-mcp.git"
  },
  "homepage": "https://github.com/zamansheikh/browser-mcp#readme",
  "author": "zamansheikh",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "browser-automation",
    "chrome-extension",
    "web-scraping",
    "ai-agents",
    "llm",
    "devtools",
    "frontend",
    "accessibility",
    "claude"
  ],
  "files": [
    "server",
    "extension",
    "scripts",
    "README.md",
    "LICENSE"
  ]
}
